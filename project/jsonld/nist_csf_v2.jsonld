    },
    {
      "name": "CsfCategory",
      "definition_uri": "https://w3id.org/lmodel/nist-csf-v2/CsfCategory",
      "description": "A group of related cybersecurity outcomes within a function, such as Organizational Context (GV.OC), or a CSF 1.1 category that CSF 2.0 withdrew, which the catalog keeps with its status and, where NIST recorded it, where it moved or what incorporated it.",
      "comments": [
        "A withdrawn category keeps its CSF 1.1 subcategories, each withdrawn too, and the catalog gives it no statement, so it has no description."
      ],
      "from_schema": "https://w3id.org/lmodel/nist-csf-v2",
      "see_also": [
        "https://www.nist.gov/cyberframework"
      ],
