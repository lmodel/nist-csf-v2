      "slot_usage": {},
      "attributes": [
        {
          "name": "csf_version",
          "description": "The CSF edition, as NIST numbers it in the publication's title, such as 2.0.",
          "required": true,
          "pattern": "^[0-9]+\\.[0-9]+$",
          "@type": "SlotDefinition"
        },
        {
          "name": "functions",
