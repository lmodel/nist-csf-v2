    },
    {
      "name": "CsfFunction",
      "definition_uri": "https://w3id.org/lmodel/nist-csf-v2/CsfFunction",
      "description": "One of the six functions that sort the CSF's outcomes at the highest level: GOVERN, IDENTIFY, PROTECT, DETECT, RESPOND and RECOVER. Each is named by two letters and described in a sentence.",
      "from_schema": "https://w3id.org/lmodel/nist-csf-v2",
      "see_also": [
        "https://www.nist.gov/cyberframework"
      ],
      "mappings": [
        "nist_csf_v2:Function"
      ],
      "broad_mappings": [
        "oscal:Group"
      ],
      "slots": [
        "title",
        "description",
        "csfFunction__function_id",
        "csfFunction__function_categories"
      ],
      "slot_usage": {},
      "attributes": [
        {
          "name": "function_id",
          "description": "The function's two letters, such as GV for GOVERN.",
          "range": "csf_function_identifier",
          "required": true,
          "@type": "SlotDefinition"
        },
        {
          "name": "function_categories",
          "description": "The categories of the function. A knowledge bundle relates a category to its function with isPartOf instead.",
          "range": "CsfCategory",
          "multivalued": true,
          "inlined": true,
          "inlined_as_list": true,
          "@type": "SlotDefinition"
        }
      ],
      "class_uri": "https://w3id.org/lmodel/nist-csf-v2/Function",
